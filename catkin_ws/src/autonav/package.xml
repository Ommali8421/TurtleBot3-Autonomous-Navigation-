<?xml version="1.0"?>
<package format="2">
  <name>autonav</name>
  <version>1.0.0</version>
  <description>Autonomous navigation package for TurtleBot3 Burger in ROS Melodic/Noetic using AMCL and move_base action client.</description>

  <maintainer email="student@robotics.edu">Robotics Student</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>rospy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>actionlib</depend>
  <depend>actionlib_msgs</depend>
  <depend>move_base_msgs</depend>

  <export>
  </export>
</package>

